# Frontend (Vite)
# The Convex dev server prints this when it connects. Paste it here.
VITE_CONVEX_URL=

# Application mode
# "local"  (default) — single-user, self-hosted, no authentication
# "hosted"           — multi-user, Google OAuth sign-in required
# Leave unset for local mode.
VITE_APP_MODE=local

# ---------------------------------------------------------------
# AI Provider (server-side on Convex — never expose through VITE_*)
#
# Thesis Navigator talks to any OpenAI-compatible API. Configure one
# of the three options below on your Convex deployment:
#   npx convex env set AI_PROVIDER openai
#   npx convex env set AI_API_KEY <your-key>
#
# Option 1 — OpenAI
# AI_PROVIDER=openai
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=
# AI_MODEL=gpt-4o
# AI_EXTRACTION_MODEL=gpt-4o-mini        # optional, used for tables/figures/entities
#
# Option 2 — OpenRouter (Claude, DeepSeek, Kimi, Gemini, Mistral, ...)
# AI_PROVIDER=openrouter
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_API_KEY=
# AI_MODEL=anthropic/claude-sonnet-4
#
# Option 3 — Any custom OpenAI-compatible endpoint
# AI_PROVIDER=custom
# AI_BASE_URL=https://your-provider.example.com/v1
# AI_API_KEY=
# AI_MODEL=your-model-name
#
# Legacy fallback: if none of the AI_* variables are set, Thesis
# Navigator uses OpenAI with OPENAI_API_KEY (existing behavior).
# Do not configure both unless you are intentionally migrating.
# ---------------------------------------------------------------

# Backend (Convex)
APP_MODE=local
OPENAI_API_KEY=

# Hosted mode only (multi-user Google OAuth)
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# SITE_URL=
