# Frontend (Vite) — copy this file to .env.local for local development.
# URL of your Convex deployment, e.g. https://shiny-otter-123.convex.cloud
VITE_CONVEX_URL=

# Backend (Convex) — set with: npx convex env set KEY value

# OpenAI API key: Q&A (gpt-4o), vision extraction (gpt-4o-mini), entity and gap analysis.
OPENAI_API_KEY=

# Google OAuth — redirect URI must include <CONVEX_SITE_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Transactional email provider for OTP codes (JSON body: { to, subject, text, html }, Bearer auth)
EMAIL_API_KEY=
EMAIL_API_URL=
