# ─────────────────────────────────────────────────────────────
# Thesis Navigator environment configuration
#
# Two deployment modes:
#   local  (default) — single-user, self-hosted. No authentication,
#                      no email, no OAuth. Only the three variables
#                      below are needed.
#   hosted           — public, multi-user. Adds Google OAuth and
#                      auth URL configuration.
# ─────────────────────────────────────────────────────────────

# ── REQUIRED FOR LOCAL MODE ──────────────────────────────────

# Frontend (Vite) — copy this file to .env.local
# Deployment mode: "local" (default when unset) or "hosted".
VITE_APP_MODE=local

# Convex cloud URL of your deployment, e.g. https://shiny-otter-123.convex.cloud
# Printed by `npx convex dev` the first time it runs.
VITE_CONVEX_URL=

# Backend (Convex) — set with: npx convex env set KEY value
# Deployment mode on the backend: "local" (default when unset) or "hosted".
APP_MODE=local

# OpenAI API key — Q&A answers (gpt-4o), table/figure vision
# extraction (gpt-4o-mini), entity extraction, and gap analysis.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── HOSTED MODE ONLY ─────────────────────────────────────────

# Google OAuth client — required for sign-in when APP_MODE=hosted.
# Create at https://console.cloud.google.com/apis/credentials
# Redirect URI: <CONVEX_SITE_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Your app's frontend URL — where auth redirects users back after
# sign-in. Local development: http://localhost:5173
SITE_URL=
