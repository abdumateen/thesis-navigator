# ─────────────────────────────────────────────────────────────
# Frontend (Vite) — copy this file to .env.local
# VITE_ variables are embedded into the browser bundle and are
# NOT secret. Backend variables are set on Convex, never here.
# ─────────────────────────────────────────────────────────────

# Convex cloud URL of your deployment, e.g. https://shiny-otter-123.convex.cloud
# Printed by `npx convex dev` the first time it runs.
VITE_CONVEX_URL=

# ─────────────────────────────────────────────────────────────
# Backend (Convex) — set with `npx convex env set KEY value`
# (run inside the repo with your Convex project linked), or in
# the Convex dashboard under Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# Your app's frontend URL — where auth redirects users back after
# sign-in. Local development: http://localhost:5173
SITE_URL=

# URL of the same Convex deployment ending in .convex.site
# (e.g. https://shiny-otter-123.convex.site). Convex sets
# CONVEX_SITE_URL on its own; override only if auth callbacks
# must go through a custom domain.
# CUSTOM_AUTH_SITE_URL=

# OpenAI API key — Q&A answers (gpt-4o), table/figure vision
# extraction (gpt-4o-mini), entity extraction, and gap analysis.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google OAuth client — required for "Continue with Google".
# Create at https://console.cloud.google.com/apis/credentials
# Redirect URI: <CONVEX_SITE_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Transactional email provider — required for email code sign-in.
# EMAIL_API_URL must accept POST with JSON body:
#   { "to", "subject", "text", "html" }
# and authenticate with `Authorization: Bearer <EMAIL_API_KEY>`.
# Any provider (or a tiny wrapper around SMTP) that meets this
# contract works.
EMAIL_API_KEY=
EMAIL_API_URL=
